# LLM connection for Stage 2 agents + Stage 3 comparator.
#
# This project uses a local Ollama instance as the LLM provider.
# NO cloud / paid API keys are required. NO MiniMax/OpenAI/Anthropic keys
# are read or required.
#
# Copy this file to `.env` and adjust as needed. `.env` is gitignored.

# Informational label only — kept for logs / debugging.
CRA_LLM_PROVIDER=ollama

# Ollama endpoint (the default is the standard local install).
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama model. Default is `qwen2.5:3b` — small enough for typical laptops,
# chat-tuned, and a good fit for the structured-JSON outputs the agents need.
# Pull with:    ollama pull qwen2.5:3b
# Other working choices: qwen2.5:7b (needs more RAM), llama3.2:3b,
# gemma3:4b, mistral:7b-instruct.
OLLAMA_MODEL=qwen2.5:3b

# Tunables (defaults are tuned for CPU-only laptops).
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_NUM_PREDICT=1536
OLLAMA_TEMPERATURE=0.2

# When set to "1", agents + comparator run against a deterministic local
# stub instead of Ollama. REQUIRED by the automated test suite so tests
# never depend on a running model. Leave unset (or "0") in production.
# CRA_LLM_STUB=1
